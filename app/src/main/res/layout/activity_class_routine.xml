
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class Routine 📚"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#123B78"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Course Name"/>

        <EditText
            android:id="@+id/etCourseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Course Code"/>

        <EditText
            android:id="@+id/etClassTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Class Time"/>

        <EditText
            android:id="@+id/etRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room Number"/>

        <EditText
            android:id="@+id/etTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teacher Name"/>

        <Button
            android:id="@+id/btnAddRoutine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Routine"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Class Schedule"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#123B78"
            android:layout_marginTop="28dp"/>

        <LinearLayout
            android:id="@+id/routineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>
